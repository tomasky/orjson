name = "kupas/orjson"

version = "0.1.1"

readme = "README.mbt.md"

repository = "https://github.com/tomasky/orjson"

license = "Apache-2.0"

keywords = [ "json", "orjson", "yyjson" ]

preferred_target = "native"

description = "MoonBit bindings for orjson's JSON engine (yyjson), with orjson-compatible parsing and serialization semantics."
