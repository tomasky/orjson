///|
test "dumps fuzz vs orjson" {
  for case in diff_cases() {
    let (input, compact, sorted, indented, withnl) = case
    let v = @orjson.parse(input)
    assert_eq(@orjson.stringify(v), compact)
    assert_eq(@orjson.stringify_with(v, sort_keys=true), sorted)
    assert_eq(@orjson.stringify_with(v, indent=2, sort_keys=true), indented)
    assert_eq(
      @orjson.stringify_with(v, sort_keys=true, append_newline=true),
      withnl,
    )
  }
}

///|
test "raw fuzz vs orjson" {
  assert_eq(@orjson.stringify(@orjson.Json::Raw("{invalid")), "{invalid")
  assert_eq(@orjson.stringify(@orjson.Json::Raw("[1,2]")), "[1,2]")
  assert_eq(@orjson.stringify(@orjson.Json::Raw("\"x\"")), "\"x\"")
  assert_eq(@orjson.stringify(@orjson.Json::Raw(" 1 ")), " 1 ")
}
